# ==============================================================================
# AI Clinical Lab Report Explainer — Environment Variables Template
# Copy this file to .env and configure keys for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Clinical AI Engine (Google Gemini)
# ------------------------------------------------------------------------------
# Required for clinical explanation generation, vision fallback OCR, and embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Authentication & Cryptographic Security
# ------------------------------------------------------------------------------
# Production requires a cryptographically secure 256-bit key (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_at_least_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. Environment & Security Mode
# ------------------------------------------------------------------------------
# Options: development, staging, production
ENVIRONMENT=development
RELEASE_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 4. Relational Database & Cloud Persistence
# ------------------------------------------------------------------------------
# Local development default: sqlite:///data/lab_cds.db
# Production (Neon Serverless PostgreSQL):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///data/lab_cds.db

# Database connection pool settings (tuned for serverless PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# 5. Network, CORS & Frontend Integration
# ------------------------------------------------------------------------------
# Comma-separated list of trusted web origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8501,http://localhost:8000
# Regex pattern to match Vercel/Cloudflare preview deployment URLs
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Frontend Vercel Environment Variable (Point React frontend to production backend API)
VITE_API_BASE_URL=https://your-production-backend-url.hf.space

# ------------------------------------------------------------------------------
# 6. Performance & Memory Optimization Toggles
# ------------------------------------------------------------------------------
# Set to true on low-memory hosting (e.g. 512MB RAM free tiers) to bypass CPU cross-encoder
DISABLE_CROSS_ENCODER=false
# Set to true during automated integration test runs to bypass sliding window rate limits
DISABLE_RATE_LIMITING=false

# ------------------------------------------------------------------------------
# 7. SRE Observability & Distributed Tracing (Langfuse & Sentry)
# ------------------------------------------------------------------------------
# Optional: Set to record token costs, trace spans, and latency percentiles
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional Sentry DSN (patient health identifiers are automatically scrubbed)
SENTRY_DSN=
