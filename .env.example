# ==============================================================================
# AI Clinical Lab Report Explainer — Environment Variables Template
# Copy this file to .env and configure keys for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Clinical AI Engine (Google Gemini)
# ------------------------------------------------------------------------------
# Required for real-time clinical explanation generation, vision fallback OCR, and embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# SRE Observability & Distributed Tracing (Langfuse)
# ------------------------------------------------------------------------------
# Optional: Set these to record token costs, trace spans, and latency percentiles
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# Error Monitoring & HIPAA PHI-Safe Telemetry (Sentry)
# ------------------------------------------------------------------------------
# Optional: All events are automatically scrubbed of patient identifiers before sending
SENTRY_DSN=
ENVIRONMENT=development
RELEASE_VERSION=1.0.0

# ------------------------------------------------------------------------------
# Distributed Worker & Storage (Stage 1 & 2)
# ------------------------------------------------------------------------------
# PostgreSQL with pgvector extension enabled
DATABASE_URL=postgresql://lab_user:lab_secure_password@localhost:5432/lab_explainer_db

# Redis for caching & asynchronous task broker
REDIS_URL=redis://localhost:6379/0

# Optional API endpoint used by the Streamlit frontend when decoupled
API_BASE_URL=http://localhost:8000
