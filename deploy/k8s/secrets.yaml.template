# Template for production Kubernetes Secrets.
# In production, manage via SealedSecrets, AWS Secrets Manager, or HashiCorp Vault.
apiVersion: v1
kind: Secret
metadata:
  name: cds-secrets
  namespace: clinical-cds
  labels:
    app.kubernetes.io/name: lab-report-explainer
type: Opaque
stringData:
  # Google Gemini Clinical CDS API Key
  GEMINI_API_KEY: "REPLACE_WITH_PRODUCTION_GEMINI_API_KEY"
  
  # Database Credentials (pgvector enabled)
  POSTGRES_PASSWORD: "REPLACE_WITH_STRONG_POSTGRES_PASSWORD"
  
  # Redis Cache & Task Broker Password
  REDIS_PASSWORD: "REPLACE_WITH_STRONG_REDIS_PASSWORD"
  
  # SRE Sentry DSN for HIPAA Error Telemetry
  SENTRY_DSN: "REPLACE_WITH_SENTRY_PROJECT_DSN"
  
  # Langfuse Distributed Observability Keys
  LANGFUSE_PUBLIC_KEY: "REPLACE_WITH_LANGFUSE_PUBLIC_KEY"
  LANGFUSE_SECRET_KEY: "REPLACE_WITH_LANGFUSE_SECRET_KEY"
  LANGFUSE_HOST: "https://cloud.langfuse.com"
